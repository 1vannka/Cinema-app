<!DOCTYPE html>
<html lang="ru">
<head>
    {{> head }}
    <title>Редактировать: {{movie.title}} - КиноРум</title>
</head>
<body>
{{> header }}

<main id="main-content" class="form-container">
    <section class="movie-form-wrapper">
        <h2>Редактировать фильм</h2>

        <form action="/movies/{{movie.id}}/edit" method="POST" class="movie-form">
            <div>
                <label>Название:</label>
                <input type="text" name="title" value="{{movie.title}}" required>
            </div>

            <div>
                <label>Ссылка на постер (URL):</label>
                <input type="text" name="image" value="{{movie.image}}">
            </div>

            <div class="form-row">
                <div class="form-col">
                    <label>Режиссер:</label>
                    <input type="text" name="director" value="{{movie.director}}">
                </div>
                <div class="form-col">
                    <label>Жанр:</label>
                    <input type="text" name="genre" value="{{movie.genre}}">
                </div>
            </div>

            <div class="form-row">
                <div class="form-col">
                    <label>Длительность (мин):</label>
                    <input type="number" name="duration" value="{{movie.duration}}">
                </div>
                <div class="form-col">
                    <label>Год:</label>
                    <input type="number" name="year" value="{{movie.year}}">
                </div>
            </div>

            <div>
                <label>Описание:</label>
                <textarea name="description" rows="5" required>{{movie.description}}</textarea>
            </div>

            <button type="submit" class="card-movie_button" style="margin-top: 10px;">Сохранить изменения</button>

            <div style="text-align: center; margin-top: 15px;">
                <a href="/movies/{{movie.id}}" style="color: #8C715A; text-decoration: underline;">Отмена</a>
            </div>
        </form>
    </section>
</main>

{{> footer }}
</body>
</html>