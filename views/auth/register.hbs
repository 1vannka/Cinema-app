<!DOCTYPE html>
<html lang="ru">
<head>
    {{> head }}
    <title>Регистрация - КиноРум</title>
</head>
<body>
{{> header }}

<main id="main-content">
    <div></div>

    <section class="registration-container">
        <h2>Регистрация</h2>

        <form action="/auth/register" method="POST" class="registration-form">
            <div class="form-group">
                <label for="reg-name">Ваше имя</label>
                <input type="text" id="reg-name" name="name" placeholder="Иван Иванов" required>
            </div>

            <div class="form-group">
                <label for="reg-login">Логин</label>
                <input type="text" id="reg-login" name="login" placeholder="Придумай логин" required>
            </div>

            <div class="form-group">
                <label for="reg-email">Email</label>
                <input type="email" id="reg-email" name="email" placeholder="example@mail.ru" required>
            </div>

            <div class="form-group">
                <label for="reg-password">Пароль</label>
                <input type="password" id="reg-password" name="password" placeholder="********" required>
            </div>

            {{#if authError}}
                <div class="error-message">
                    {{authError}}
                </div>
            {{/if}}

            <button type="submit" class="card-movie_button auth-btn">Зарегистрироваться</button>
        </form>

        <div class="registration-footer">
            Уже есть аккаунт? Используйте форму входа в шапке.
        </div>
    </section>

    <div></div>
</main>

{{> footer }}
</body>
</html>