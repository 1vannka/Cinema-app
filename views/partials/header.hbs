<header id="main-header">
  <h1>
    <a href="/" onclick="event.preventDefault(); window.location.href = '/' + window.location.search">КиноРум</a>
  </h1>

  {{#if user}}
    {{#unless isAdmin}}
      <a href="/users/{{user.id}}" class="profile-entry-link">Мой профиль</a>
    {{/unless}}
  {{/if}}

  {{#if isAdmin}}
    <div class="admin-tools">
      <a href="/movies/add" class="admin_button"> Добавить новый фильм </a>
      <a href="/sessions/add" class="admin_button"> Добавить сеанс </a>
    </div>
  {{/if}}

  <div class="auth-block">
    {{#if user}}
      <div class="auth-logged-in">
        <span>Вы вошли как: <strong>{{user.login}}</strong></span>
        <button id="logoutBtn" class="auth-btn logout-btn">Выйти</button>
      </div>
    {{else}}
      {{#unless hideLogin}}
        <form id="loginForm" class="auth-form" method="POST">
          <input type="email" id="auth-email" placeholder="Email" required>
          <div class="auth-password-wrap">
            <input type="password" id="auth-password" placeholder="Пароль" required>
          </div>

          <div class="auth-buttons">
            <button type="submit" class="auth-btn login-btn">Войти</button>
            <a href="/auth/register" class="auth-btn register-btn">Регистрация</a>
          </div>
        </form>
      {{/unless}}
    {{/if}}
  </div>

  <form role="search" action="/movies/search" method="get">
    <label for="site-search" class="visually-hidden">Поиск фильмов:</label>
    <input id="site-search" name="q" type="search" placeholder="По названию или жанру">
    <button type="submit">Найти</button>
  </form>
</header>

<script type="module" src="/scripts/auth.js"></script>