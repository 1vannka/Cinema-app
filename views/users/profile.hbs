<!DOCTYPE html>
<html lang="ru">
<head>
    {{> head }}
    <title>Личный кабинет - КиноРум</title>
</head>
<body>
{{> header }}

<main id="main-content">
    {{> menu }}

    <section class="profile-layout">
        <div class="profile-block-main">
            {{#if error}}
                <div class="alert alert-warning profile-warning">
                    <strong>Внимание:</strong> {{error}}
                </div>
            {{/if}}

            <h2 class="profile-name">Привет, {{#if userProfile.name}}{{userProfile.name}}{{else}}{{userProfile.login}}{{/if}}!</h2>
            <p><strong>Email:</strong> {{userProfile.email}}</p>
            <p><strong>Логин:</strong> {{userProfile.login}}</p>

            <div class="profile-actions">
                <a href="/users/{{userProfile.id}}/edit" class="card-movie_button link-plain-btn">Изменить данные</a>

                {{#unless isAdmin}}
                    <form action="/users/{{userProfile.id}}/delete" method="POST" class="inline-form" onsubmit="return confirm('Вы уверены? Это действие необратимо.');">
                        <button type="submit" class="card-movie_button profile-btn-delete">Удалить аккаунт</button>
                    </form>
                {{/unless}}
            </div>
        </div>

        <div class="profile-block-secondary">
            <h3>Мои билеты</h3>
            {{#if userProfile.tickets.length}}
                <ul class="profile-list">
                    {{#each userProfile.tickets}}
                        <li class="profile-ticket-item">
                            <div>
                                <strong>Фильм:</strong> {{this.session.movie.title}} <br>
                                <strong>Сеанс:</strong> <time>{{this.session.displayDate}}</time> <br>
                                <strong>Место:</strong> Ряд {{this.row}}, Место {{this.seat}} <br>
                                <span class="profile-ticket-status">{{this.status}}</span>
                            </div>
                            <a href="/tickets/{{this.id}}/edit" class="card-movie_button profile-ticket-btn">Управление</a>
                        </li>
                    {{/each}}
                </ul>
            {{else}}
                <p>Вы еще не купили ни одного билета</p>
            {{/if}}
        </div>

        <div class="profile-block-secondary">
            <h3>Мои отзывы</h3>
            {{#if userProfile.reviews.length}}
                <ul class="profile-list">
                    {{#each userProfile.reviews}}
                        <li class="profile-list-item">
                            <p class="profile-review-text">"{{this.comment}}"</p>
                            <small class="profile-review-date">{{this.displayDate}}</small>
                        </li>
                    {{/each}}
                </ul>
            {{else}}
                <p>Вы еще не оставляли отзывов.</p>
            {{/if}}
        </div>
    </section>
</main>

{{> footer }}
</body>
</html>