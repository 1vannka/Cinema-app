<!DOCTYPE html>
<html lang="ru">
<head>
    {{> head }}
    <title>Написать отзыв - КиноРум</title>
</head>
<body>
{{> header }}

<main id="main-content" class="form-container">
    <section class="movie-form-wrapper">
        <h2>Новый отзыв</h2>

        <form action="/reviews" method="POST" class="movie-form">
            <div>
                <label>Ваш комментарий:</label>
                <textarea name="comment" rows="6" placeholder="Поделитесь вашим мнением..." required minlength="10"></textarea>
            </div>

            <button type="submit" class="card-movie_button form-submit-spaced-lg">Опубликовать</button>

            <div class="form-cancel-wrapper">
                <a href="/feedback" class="form-cancel-link">Отмена</a>
            </div>
        </form>
    </section>
</main>

{{> footer }}
</body>
</html>